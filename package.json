{
  "name": "jarvis-wms",
  "version": "1.0.0",
  "private": true,
  "description": "WMS Operacional — sistema de gestao de armazem para operacao logistica simulada",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:reset": "node --import ./scripts/register.mjs --experimental-strip-types --no-warnings scripts/reset.ts",
    "docs:pdf": "node --import ./scripts/register.mjs --experimental-strip-types --no-warnings scripts/generate-pdfs.ts",
    "test": "WMS_DATA_DIR=.test-data node --import ./scripts/register.mjs --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:a11y": "node tests/a11y.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "next": "15.5.25",
    "pg": "^8.13.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.13.0",
    "@types/pg": "^8.11.10",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "axe-core": "^4.10.2",
    "playwright": "^1.49.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3"
  }
}
